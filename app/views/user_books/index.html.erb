<p style="color: green"><%= notice %></p>

<h1>User Books</h1>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th>Book Title</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @user_books.each do |user_book| %>
      <tr>
        <td><%= user_book.user.username %></td>
        <td><%= user_book.book.title %></td>
        <td style="padding-left: 15px;"><%= link_to "Show", user_book %></td>
        <td style="padding-left: 10px;"><%= link_to "Update", edit_user_book_path(user_book) %></td>
        <td style="padding-left: 10px;"><%= link_to "Delete", delete_user_book_path(user_book) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New User Book", new_user_book_path %>
<br>
<%= link_to "Book Index", books_path %>
<br>
<%= link_to "User Index", users_path %>

