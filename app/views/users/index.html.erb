<p style="color: green"><%= notice %></p>

<% content_for :title, "Users" %>

<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td style="padding-left: 15px;"><%= link_to "Show", user %></td>
        <td style="padding-left: 10px;"><%= link_to "Update", edit_user_path(user) %></td>
        <td style="padding-left: 10px;"><%= link_to "Delete", delete_user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New User", new_user_path %>

<br>

<%= link_to "Home", root_path %>
